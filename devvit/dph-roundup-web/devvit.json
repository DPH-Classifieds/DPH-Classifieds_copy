{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "dph-roundup-web",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["api.github.com"]
    }
  },
  "settings": {
    "global": {
      "roundupUrl": {
        "type": "string",
        "label": "GitHub roundup JSON API URL (api.github.com/repos/.../contents/...)"
      },
      "roundupToken": {
        "type": "string",
        "isSecret": true,
        "label": "Optional read-only GitHub token (blank for the public bridge repo)"
      }
    },
    "subreddit": {
      "targetSubreddit": {
        "type": "string",
        "label": "Subreddit to post to without r/ (blank = this subreddit)"
      }
    }
  },
  "scheduler": {
    "tasks": {
      "roundup": {
        "endpoint": "/internal/cron/roundup",
        "cron": "0 15 */2 * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "DPH: post roundup now",
        "description": "Fetch the prepared DPH car roundup and post it.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/roundup"
      },
      {
        "label": "DPH: force repost current roundup (testing)",
        "description": "Moderator-only test repost; limited to one attempt every 10 minutes.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/force-roundup"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "dph_roundup_web_dev2"
  }
}
