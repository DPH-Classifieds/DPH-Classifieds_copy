{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "dph-roundup-web",
  "post": {
    "entrypoints": {
      "default": {
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {},
  "permissions": {
    "http": {
      "enable": true,
      "domains": ["api.github.com"]
    }
  },
  "settings": {
    "global": {
      "githubRepo": {
        "type": "string",
        "label": "GitHub bridge repository (owner/repo)"
      },
      "githubPath": {
        "type": "string",
        "label": "GitHub bridge JSON path (e.g. dph-roundup.json)"
      },
      "githubBranch": {
        "type": "string",
        "label": "GitHub bridge branch (e.g. main)"
      },
      "githubToken": {
        "type": "string",
        "isSecret": true,
        "label": "Optional read-only GitHub token (leave blank for a public bridge repo)"
      }
    },
    "subreddit": {
      "targetSubreddit": {
        "type": "string",
        "label": "Subreddit to post to without r/ (blank = this subreddit)"
      }
    }
  },
  "scheduler": {
    "tasks": {
      "roundup": {
        "endpoint": "/internal/cron/roundup",
        "cron": "0 9 */2 * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "DPH: post roundup now",
        "description": "Fetch the latest DPH car roundup and post it.",
        "forUserType": "moderator",
        "location": "subreddit",
        "endpoint": "/internal/on/menu/roundup"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/on/app/install"
  },
  "scripts": {
    "dev": "npm run watch"
  },
  "dev": {
    "subreddit": "dph_roundup_web_dev2"
  }
}
