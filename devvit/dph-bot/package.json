{
  "private": true,
  "name": "dph-bot",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "esbuild --bundle --log-level=warning --target=es2023 --format=cjs --outdir=dist/server --platform=node src/server/index.ts",
    "test:hmac": "esbuild --bundle --log-level=warning --target=es2023 --format=cjs --outfile=dist/server/hmac.test.cjs --platform=node src/server/hmac.test.ts && node dist/server/hmac.test.cjs",
    "test:types": "tsc --noEmit",
    "test": "npm run test:types && npm run build && npm run test:hmac",
    "upload": "npm run build && devvit upload"
  },
  "devDependencies": {
    "@devvit/web": "^0.14.2",
    "@types/node": "22.20.1",
    "devvit": "^0.14.2",
    "esbuild": "0.28.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "license": "BSD-3-Clause"
}
