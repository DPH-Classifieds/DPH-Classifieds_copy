.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.local.example
!.env.local.sample
!.env.local.template
.envrc

# Secrets and credentials
.aws/credentials
.aws/config
.git-credentials
.netrc
.npmrc
!flask-react-supabase-app/mobile/.npmrc
.pypirc
.terraformrc
.terraformrc.*

# Google OAuth client secrets / service account keys
client_secret_*.json
*-service-account*.json
ga4_service_account.json
# Catch Google Cloud Console JSON downloads (filename = <project-id>-<key-id>.json)
fit-asset-*.json
.terraform.d/credentials.tfrc.json
.vault-token
*.pem
*.key
*.p12
*.pfx
*.p7b
*.p7c
*.jks
*.keystore
*.kdbx
*.ovpn
*.seed
*.csr
id_rsa
id_ed25519
id_ecdsa
id_dsa
*_rsa
*_ed25519
*_ecdsa

# Local tooling and generated artifacts
.worktrees/
.playwright-mcp/
.ruff_cache/
.pytest_cache/
skills-lock.json
.agents/
.claude/
.codex/
.fablize/
.temp/

# Holding pen for repo-root clutter (personal media, historical reports/scripts,
# planning docs) that isn't app code or deploy config — local only, never pushed.
/non-essential/
flask-react-supabase-app/supabase/.temp/
flask-react-supabase-app/supabase/supabase/
*.docx
*.pdf
*.mp4
*.MP4
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
# tracked app icons EAS Build needs to read during prebuild - the patterns
# above are meant for repo-root clutter, not these. Directory-only negation
# (trailing slash) doesn't re-include files matched by a separate *.ext rule,
# so this must be a recursive glob, not just the directory path.
!flask-react-supabase-app/mobile/assets/**
**/.DS_Store
**/node_modules/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.vercel
.env*
