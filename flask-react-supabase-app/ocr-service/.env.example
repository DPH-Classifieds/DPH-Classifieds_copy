# Shared secret — must match OCR_SERVICE_KEY on the main backend.
OCR_SERVICE_KEY=change-me-to-a-long-random-string
# Recognition language. All fields we extract (VIN, plate, make/model) are Latin.
OCR_LANG=en
# Drop detected lines below this confidence.
OCR_MIN_CONFIDENCE=0.3
# Max concurrent inferences per worker before returning 503 (busy).
OCR_MAX_CONCURRENCY=2
# How long a request waits for a free inference slot before 503.
OCR_QUEUE_TIMEOUT_SECONDS=20
# Reject uploads larger than this.
OCR_MAX_IMAGE_MB=20
OCR_MAX_IMAGE_PIXELS=25000000
# gunicorn worker processes (each loads its own predictor). Scale with CPU/RAM.
GUNICORN_WORKERS=1
