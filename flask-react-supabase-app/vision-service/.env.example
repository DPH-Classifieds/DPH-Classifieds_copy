# Must match VISION_SERVICE_KEY on the backend/worker. Keep this service private.
VISION_SERVICE_KEY=change-me-to-a-long-random-string

# Downloaded model identifiers are recorded on every response for auditability.
VISION_CLIP_MODEL=ViT-B-32
VISION_CLIP_PRETRAINED=laion2b_s34b_b79k
VISION_NSFW_SCORE_THRESHOLD=0.85
VISION_MAX_IMAGE_MB=20
VISION_MAX_IMAGE_PIXELS=25000000
VISION_MAX_CONCURRENCY=1
VISION_QUEUE_TIMEOUT_SECONDS=20
