# ===========================================
# RAILWAY PRODUCTION ENVIRONMENT VARIABLES
# ===========================================
# Copy these directly into Railway's environment variables UI
# Go to: Railway Project → Variables → Add Variable

# ===========================================
# SUPABASE (REQUIRED)
# ===========================================
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ===========================================
# RESEND EMAIL API (REQUIRED FOR EMAILS)
# ===========================================
# 1. Sign up at https://resend.com
# 2. Get API key from dashboard
# 3. Verify your domain or use onboarding@resend.dev for testing
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_TO_EMAIL=admin@yourdomain.com
RESEND_REPLY_TO_EMAIL=support@yourdomain.com

# ===========================================
# MSG91 SMS VERIFICATION (REQUIRED FOR UAE PHONE OTP)
# ===========================================
MSG91_AUTHKEY=your-msg91-authkey-here
MSG91_OTP_ENABLED=true
PHONE_VERIFICATION_TTL_MINUTES=10
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_MAX_SENDS=6
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ===========================================
# CLOUDFLARE TURNSTILE (REQUIRED)
# ===========================================
TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# ===========================================
# SITE CONFIGURATION (REQUIRED)
# ===========================================
SITE_NAME=DPH Classifieds
SITE_URL=https://your-railway-domain.com

# ===========================================
# FLASK CONFIGURATION
# ===========================================
FLASK_SECRET_KEY=generate-random-secret-key-here
FLASK_ENV=production
FLASK_DEBUG=false

# ===========================================
# CORS (REQUIRED - ADD YOUR RAILWAY DOMAIN)
# ===========================================
CORS_ORIGINS=https://www.dphclassifieds.com,https://dphclassifieds.com,https://your-railway-domain.railway.app,https://your-custom-domain.com

# ===========================================
# SHARED RUNTIME SERVICES / ANALYTICS
# ===========================================
REDIS_URL=redis://default:your-password@your-redis-host:6379
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
HEALTH_FRONTEND_URL=https://www.dphclassifieds.com
HEALTH_BACKEND_URL=https://api.dphclassifieds.com
TRUSTED_PROXY_HOPS=1
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_TTL_SECONDS=120
WORKER_HEARTBEAT_KEY=dph:health:worker:heartbeat
ENABLE_DEALER_PANEL=true

# ===========================================
# RATE LIMITING
# ===========================================
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SEC=300
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SEC=3600

# ===========================================
# LISTING CONFIGURATION
# ===========================================
MAX_LISTINGS_PER_USER=4
MAX_UPLOAD_SIZE_MB=10
LISTING_EXPIRY_DAYS=15
LISTING_RETENTION_DAYS=30
LISTING_SOLD_RESPONSE_WINDOW_HOURS=48
LISTING_DISPLAY_WIDTH=1600
LISTING_DISPLAY_HEIGHT=1000

# ===========================================
# REGISTRATION OCR / VIN VALIDATION
# ===========================================
OCR_SERVICE_URL=http://ocr-service.railway.internal:8080
OCR_SERVICE_KEY=must-match-the-ocr-service-OCR_SERVICE_KEY
OCR_SERVICE_TIMEOUT_SECONDS=30
# Dealer documents use one RGB pass plus one luminance fallback pass.
OCR_DEALER_PASSES=2
VISION_SERVICE_MODE=disabled
VISION_SERVICE_URL=http://vision-service.railway.internal:8080
VISION_SERVICE_KEY=must-match-the-vision-service-VISION_SERVICE_KEY
VISION_SERVICE_TIMEOUT_SECONDS=12
# OCR runs on the standalone PaddleOCR service.
OCR_CONFIDENCE_THRESHOLD=0.90
# Reserved for future confidence-band reporting; OCR_CONFIDENCE_THRESHOLD is the review gate.
OCR_REVIEW_THRESHOLD=0.75
VIN_DECODER_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles/decodevinvaluesextended
VIN_DECODER_CACHE_TTL_SECONDS=86400
VIN_DECODER_MAX_CACHE_ENTRIES=1000
VIN_DECODER_TIMEOUT_SECONDS=6
OCR_MAX_RESIZE_PIXELS=6000000
OCR_MAX_IMAGE_WIDTH=2400
OCR_MAX_IMAGE_HEIGHT=2400

# ===========================================
# PRODUCTION SETTINGS (RAILWAY)
# ===========================================
NODE_ENV=production
PYTHONUNBUFFERED=1

# 48-hour user reminder system
# Draft listing reminders (every 48 hours)
DRAFT_REMINDER_INTERVAL_SECONDS=172800
# Saved car reminders (every 48 hours)
SAVED_CAR_REMINDER_INTERVAL_SECONDS=172800
# Saved search result alerts (every 48 hours)
SAVED_SEARCH_ALERT_INTERVAL_SECONDS=172800
# For testing: set to 60 to fire every minute instead of every 48h
# DRAFT_REMINDER_INTERVAL_SECONDS=60
# SAVED_CAR_REMINDER_INTERVAL_SECONDS=60
# SAVED_SEARCH_ALERT_INTERVAL_SECONDS=60
