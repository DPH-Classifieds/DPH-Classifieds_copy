# ===========================================
# DPH Classifieds - Backend Environment
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
PRIMARY_SUPER_ADMIN_EMAIL=admin@dphclassifieds.com
PRIMARY_SUPER_ADMIN_USERNAME=DPHClassifieds
PRIMARY_SUPER_ADMIN_USER_ID=

# ===========================================
# EMAIL CONFIGURATION - RESEND API (REQUIRED)
# ===========================================
# Get your API key from https://resend.com
# Free tier: 100 emails/day, 3000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_TO_EMAIL=admin@yourdomain.com
RESEND_REPLY_TO_EMAIL=support@yourdomain.com

# ===========================================
# INFOBIP SMS VERIFICATION (REQUIRED FOR PHONE OTP)
# ===========================================
INFOBIP_API_KEY=your-infobip-api-key-here
INFOBIP_BASE_URL=https://api.infobip.com
INFOBIP_SENDER=ServiceSMS
PHONE_VERIFICATION_TTL_MINUTES=10
PHONE_VERIFICATION_MAX_ATTEMPTS=5
PHONE_VERIFICATION_MAX_SENDS=6
PHONE_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# ===========================================
# HEALTH MONITORING
# ===========================================
HEALTH_FRONTEND_URL=
HEALTH_BACKEND_URL=
# Example: https://api.dphclassifieds.com/api/health/live
HEALTH_CHECK_INTERVAL_SECONDS=1800
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_TTL_SECONDS=120
HEALTH_ALERT_COOLDOWN_SECONDS=1800
HEALTH_HTTP_TIMEOUT_SECONDS=8
WORKER_HEARTBEAT_KEY=dph:health:worker:heartbeat
HEALTH_ALERT_SENT_KEY=dph:health:alert:last_sent

# ===========================================
# CACHE / REDIS
# ===========================================
# Set this on the Railway web service and worker service if you want shared cache
# and worker heartbeat storage to use Redis instead of in-process memory.
REDIS_URL=redis://default:your-password@your-redis-host:6379
API_CACHE_TTL_SECONDS=300

# ===========================================
# CLOUDFLARE TURNSTILE (CAPTCHA) (REQUIRED)
# ===========================================
# Get your keys from https://www.cloudflare.com/products/turnstile/
TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# ===========================================
# SITE CONFIGURATION (REQUIRED)
# ===========================================
SITE_NAME=DPH Classifieds
# Local: http://localhost:3000
# Production: https://your-domain.com
SITE_URL=http://localhost:3000

# ===========================================
# FLASK CONFIGURATION
# ===========================================
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Comma-separated list of allowed origins
# Local: http://localhost:3000
# Production: https://dphclassifieds.com,https://www.dphclassifieds.com
CORS_ORIGINS=http://localhost:3000

# ===========================================
# RATE LIMITING
# ===========================================
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SEC=300
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SEC=3600

# ===========================================
# LISTING CONFIGURATION
# ===========================================
MAX_LISTINGS_PER_USER=4
MAX_UPLOAD_SIZE_MB=10
LISTING_EXPIRY_DAYS=15
LISTING_RETENTION_DAYS=30
LISTING_SOLD_RESPONSE_WINDOW_HOURS=48
LISTING_DISPLAY_WIDTH=1600
LISTING_DISPLAY_HEIGHT=1000

# ===========================================
# REGISTRATION OCR / VIN VALIDATION
# ===========================================
# Server-side registration document scanning. Requires Tesseract installed on the host.
OCR_PROVIDER=local_tesseract
OCR_CONFIDENCE_THRESHOLD=0.90
# Reserved for future confidence-band reporting; OCR_CONFIDENCE_THRESHOLD is the review gate.
OCR_REVIEW_THRESHOLD=0.75
VIN_DECODER_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles/decodevinvaluesextended
VIN_DECODER_CACHE_TTL_SECONDS=86400
VIN_DECODER_MAX_CACHE_ENTRIES=1000
VIN_DECODER_TIMEOUT_SECONDS=6
OCR_MAX_RESIZE_PIXELS=6000000
OCR_MAX_IMAGE_WIDTH=2400
OCR_MAX_IMAGE_HEIGHT=2400
TESSERACT_CMD=/usr/bin/tesseract

# ===========================================
# OPTIONAL: FLASK-MAIL FALLBACK (SMTP)
# ===========================================
# Only used if Resend is not configured
# For Gmail: enable "Less secure apps" or use App Password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ===========================================
# GA4 DATA API (REQUIRED for admin dashboard GA4 KPIs)
# ===========================================
# Used by the backend to pull GA4 numbers into /api/admin/ga4-summary so the
# operator dashboard can render Active Users / Sessions / Conversions inline.
# Web tracking still works without these — they only power the in-app KPI pull.
#
# How to get them:
#   1. https://console.cloud.google.com → create (or reuse) a project for analytics
#   2. APIs & Services → Library → enable "Google Analytics Data API"
#   3. APIs & Services → Credentials → "Create Credentials" → Service Account
#      Name it "dph-ga4-reader". Skip optional steps.
#   4. Open the service account → Keys → "Add Key" → JSON → download the file
#   5. In analytics.google.com → Admin → Property Access Management
#      Add the service-account email (looks like *@*.iam.gserviceaccount.com)
#      with the "Viewer" role on the GA4 property
#   6. Property ID is in GA4 → Admin → Property Settings → "Property ID"
#      (a number like 312345678 — NOT the G-XXXXX measurement ID)
#   7. Paste the *entire JSON file contents* on one line into GA4_SERVICE_ACCOUNT_JSON.
#      On Railway/Heroku, paste it as a single-line JSON string.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Optional: how many minutes to cache GA4 responses (default 5).
# GA4 data is 1–3 hours stale anyway; caching protects the quota.
GA4_CACHE_TTL_SECONDS=300

# ===========================================
# MICROSOFT CLARITY (OPTIONAL — links from admin panel)
# ===========================================
# Only needed if you want a working "Open Clarity Dashboard" deep-link button
# in the admin panel. Clarity has no embeddable iframe (X-Frame-Options: DENY).
# Project ID is the same one you put in REACT_APP_CLARITY_PROJECT_ID.
CLARITY_PROJECT_ID=

# ===========================================
# OPTIONAL: BETA GATE PASSWORD
# ===========================================
# Leave empty to disable beta gate
BETA_PASSWORD=

# ===========================================
# PRODUCTION ONLY (Railway/Heroku/etc.)
# ===========================================
# NODE_ENV=production
# PYTHONUNBUFFERED=1
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
