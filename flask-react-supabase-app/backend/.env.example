# Supabase Configuration
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_SECRET_KEY=your-secret-key-here-change-this-in-production

# CORS Configuration (comma-separated, no localhost in production!)
CORS_ORIGINS=https://dphclassifieds.com,https://www.dphclassifieds.com

# Cloudflare Turnstile (Captcha) - GET YOUR KEYS FROM https://www.cloudflare.com/products/turnstile/
TURNSTILE_SITE_KEY=your-turnstile-site-key-here
TURNSTILE_SECRET_KEY=your-turnstile-secret-key-here

# Rate Limiting (in-memory, for production use Redis)
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_SEC=300

# Listing Limits
MAX_LISTINGS_PER_USER=4

# Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Beta Gate (optional - leave empty to disable)
BETA_PASSWORD=
