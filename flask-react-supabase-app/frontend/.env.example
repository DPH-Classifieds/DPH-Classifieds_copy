# ===========================================
# DPH Classifieds - Frontend Environment
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
REACT_APP_SUPABASE_URL=https://your-project-url.supabase.co
REACT_APP_SUPABASE_KEY=your-anon-key-here

# ===========================================
# API CONFIGURATION (REQUIRED)
# ===========================================
# Local: http://localhost:5000
# Production: https://your-backend-domain.com
REACT_APP_API_URL=http://localhost:5000

# ===========================================
# MSG91 OTP WIDGET (optional — enables client-side OTP via MSG91)
# ===========================================
# Set BOTH to switch phone OTP from Infobip SMS to the MSG91 widget.
# Leave unset to keep the existing Infobip SMS flow.
REACT_APP_MSG91_WIDGET_ID=
REACT_APP_MSG91_TOKEN_AUTH=

# ===========================================
# CLOUDFLARE TURNSTILE SITE KEY (REQUIRED)
# ===========================================
# Get from https://www.cloudflare.com/products/turnstile/
# Must match TURNSTILE_SITE_KEY in backend .env
REACT_APP_TURNSTILE_SITE_KEY=your-turnstile-site-key

# ===========================================
# OPTIONAL: FEATURE FLAGS
# ===========================================
# REACT_APP_ENABLE_BETA_GATE=false

# ===========================================
# ANALYTICS (REQUIRED for admin dashboards: GA4 + Clarity)
# ===========================================
#
# --- Google Analytics 4 (Measurement ID) ---
# How to get it:
#   1. Go to https://analytics.google.com → Admin (gear icon, bottom left)
#   2. Create Property → "DPH Classifieds Web" → choose UAE timezone, AED currency
#   3. Add a "Web" data stream → enter https://dphclassifieds.com → Create
#   4. Copy the "Measurement ID" — it starts with G- (e.g. G-AB12C34DEF)
#   5. Mark these as conversions in GA4 → Admin → Events:
#      contact_click_call, contact_click_whatsapp, sign_up, post_listing_success
REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Microsoft Clarity (Project ID) ---
# How to get it:
#   1. Go to https://clarity.microsoft.com → Sign in with Microsoft account
#   2. New project → "DPH Classifieds" → site URL https://dphclassifieds.com → Create
#   3. The 10-character Project ID is shown in the install snippet
#      ("clarity('init', 'abc1234567')") and in Settings → Setup
REACT_APP_CLARITY_PROJECT_ID=your-clarity-project-id

# ===========================================
# OPTIONAL: ERROR REPORTING
# ===========================================
# REACT_APP_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ===========================================
# PRODUCTION BUILD (Railway/Vercel/Netlify)
# ===========================================
# CI=true
# GENERATE_SOURCEMAP=false
