{
  "installCommand": "cd flask-react-supabase-app/frontend && npm install",
  "buildCommand": "cd flask-react-supabase-app/frontend && npm run build",
  "outputDirectory": "flask-react-supabase-app/frontend/build",
  "framework": "create-react-app",
  "rewrites": [
    {
      "source": "/((?!static/|images/|favicon.ico|manifest.json|robots.txt|sitemap.xml|asset-manifest.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }
      ]
    }
  ]
}
